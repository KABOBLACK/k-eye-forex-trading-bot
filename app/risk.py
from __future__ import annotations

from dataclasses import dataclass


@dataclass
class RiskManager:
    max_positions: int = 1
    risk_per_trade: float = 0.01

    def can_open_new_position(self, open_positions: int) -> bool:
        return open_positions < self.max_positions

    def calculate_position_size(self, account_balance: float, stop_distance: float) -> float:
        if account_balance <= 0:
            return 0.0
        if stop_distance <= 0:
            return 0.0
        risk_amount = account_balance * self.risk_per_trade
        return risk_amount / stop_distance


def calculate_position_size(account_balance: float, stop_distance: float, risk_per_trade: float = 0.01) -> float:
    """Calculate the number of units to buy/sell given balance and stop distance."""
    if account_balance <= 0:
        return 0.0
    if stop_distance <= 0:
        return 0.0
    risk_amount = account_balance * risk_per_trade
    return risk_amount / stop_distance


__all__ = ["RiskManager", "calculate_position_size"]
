from __future__ import annotations

from typing import Iterable, List


def calculate_ema(values: Iterable[float], period: int) -> List[float]:
    """Calculate the exponential moving average for a series of price values."""
    series = list(values)
    if not series:
        return []
    if period <= 0:
        raise ValueError("period must be greater than 0")

    multiplier = 2.0 / (period + 1.0)
    ema_values: List[float] = []
    previous_ema = series[0]

    for price in series:
        previous_ema = price * multiplier + previous_ema * (1 - multiplier)
        ema_values.append(previous_ema)

    return ema_values


def calculate_rsi(values: Iterable[float], period: int = 14) -> List[float]:
    """Calculate RSI using Wilder's smoothing method."""
    series = list(values)
    if not series:
        return []
    if period <= 0:
        raise ValueError("period must be greater than 0")

    deltas = [series[index] - series[index - 1] for index in range(1, len(series))]
    gains = [max(delta, 0.0) for delta in deltas]
    losses = [abs(min(delta, 0.0)) for delta in deltas]

    if len(gains) < period:
        return [50.0] * len(series)

    avg_gain = sum(gains[:period]) / period
    avg_loss = sum(losses[:period]) / period

    rsi_values = [50.0] * len(series)
    for index in range(period, len(deltas) + 1):
        if avg_loss == 0:
            rsi = 100.0
        else:
            relative_strength = avg_gain / avg_loss
            rsi = 100 - (100 / (1 + relative_strength))
        rsi_values[index] = rsi

        if index < len(deltas):
            avg_gain = ((avg_gain * (period - 1)) + gains[index]) / period
            avg_loss = ((avg_loss * (period - 1)) + losses[index]) / period

    return rsi_values
